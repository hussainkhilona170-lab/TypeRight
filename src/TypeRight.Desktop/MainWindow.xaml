<Window x:Class="TypeRight.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TypeRight 2.0" Height="640" Width="680"
        MinHeight="500" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F7FA"
        Icon="Resources/TypeRight.ico">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF2C3E50" Padding="20,16">
            <StackPanel>
                <TextBlock Text="TypeRight 2.0" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Windows typing companion - private, local, native" FontSize="13" Foreground="#FFBDC3C7" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,8,20,12">
            <StackPanel>

                <!-- Status Card -->
                <Border Background="White" CornerRadius="6" Padding="16" Margin="0,12,0,8"
                        BorderBrush="#FFE0E6ED" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusIndicator" Width="12" Height="12" Fill="#FF27AE60" Margin="0,0,10,0"/>
                            <TextBlock x:Name="StatusText" Text="Service running - correction engine active" FontSize="15" FontWeight="SemiBold" Foreground="#FF2C3E50"/>
                        </StackPanel>
                        <TextBlock Text="TypeRight is running in your system tray. Configure settings below or test the correction engine."
                                   Style="{StaticResource BodyText}" Margin="22,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Test Area Card -->
                <Border Background="White" CornerRadius="6" Padding="16" Margin="0,8,0,8"
                        BorderBrush="#FFE0E6ED" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Correction Engine Test" Style="{StaticResource HeaderText}" Margin="0,0,0,4"/>
                        <TextBlock Text="Type a word below to see how TypeRight evaluates it. This tests the real correction engine."
                                   Style="{StaticResource BodyText}"/>
                        <Grid Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TestWordBox" Grid.Column="0" FontSize="18" Padding="10"
                                     VerticalContentAlignment="Center" TextChanged="TestWordBox_TextChanged"/>
                            <Button x:Name="TestButton" Grid.Column="1" Content="Check" Style="{StaticResource PrimaryButton}"
                                    Click="TestButton_Click" Margin="8,0,0,0"/>
                        </Grid>
                        <Border x:Name="ResultPanel" Background="#FFF8F9FA" CornerRadius="4" Padding="12" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="ResultAction" FontSize="14" FontWeight="Bold" Foreground="#FF2C3E50"/>
                                <TextBlock x:Name="ResultDetail" FontSize="13" Foreground="#FF34495E" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ResultConfidence" FontSize="12" Foreground="#FF7F8C8D" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Settings Card -->
                <Border Background="White" CornerRadius="6" Padding="16" Margin="0,8,0,8"
                        BorderBrush="#FFE0E6ED" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Settings" Style="{StaticResource HeaderText}" Margin="0,0,0,8"/>

                        <!-- Language Variant -->
                        <TextBlock Text="English variant" FontWeight="SemiBold" FontSize="13" Foreground="#FF2C3E50"/>
                        <ComboBox x:Name="LanguageCombo" Margin="0,4,0,12" FontSize="13">
                            <ComboBoxItem Content="Auto - accept both British and American"/>
                            <ComboBoxItem Content="American English (en-US)"/>
                            <ComboBoxItem Content="British English (en-GB)"/>
                        </ComboBox>

                        <!-- Personal Learning -->
                        <CheckBox x:Name="PersonalLearningCheck" Content="Enable personal learning (opt-in, stored locally only)"
                                  FontSize="13" Foreground="#FF34495E" Margin="0,4,0,4"
                                  Checked="PersonalLearningCheck_Changed" Unchecked="PersonalLearningCheck_Changed"/>
                        <StackPanel Orientation="Horizontal" Margin="22,0,0,10">
                            <TextBox x:Name="PersonalWordBox" Width="260" FontSize="13" Padding="6"
                                     ToolTip="Add a single word to accept locally"/>
                            <Button x:Name="AddPersonalWordButton" Content="Add word"
                                    Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                    Click="AddPersonalWordButton_Click"/>
                        </StackPanel>

                        <!-- Show Suggestions -->
                        <CheckBox x:Name="ShowSuggestionsCheck" Content="Show suggestion overlay" IsChecked="True"
                                  FontSize="13" Foreground="#FF34495E" Margin="0,4,0,10"/>

                        <!-- Confidence Threshold -->
                        <TextBlock Text="Confidence threshold" FontWeight="SemiBold" FontSize="13" Foreground="#FF2C3E50"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Slider x:Name="ConfidenceSlider" Minimum="0.4" Maximum="0.95" Value="0.65"
                                    Width="300" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    ValueChanged="ConfidenceSlider_ValueChanged"/>
                            <TextBlock x:Name="ConfidenceValue" Text="0.65" Margin="12,0,0,0" VerticalAlignment="Center"
                                       FontSize="13" Foreground="#FF34495E"/>
                        </StackPanel>
                        <TextBlock Text="Higher = more conservative (fewer corrections)" FontSize="11" Foreground="#FF7F8C8D" Margin="0,0,0,12"/>

                        <!-- Excluded Applications -->
                        <TextBlock Text="Excluded applications (one process name per line)" FontWeight="SemiBold" FontSize="13" Foreground="#FF2C3E50"/>
                        <TextBox x:Name="ExcludedAppsBox" AcceptsReturn="True" Height="70" FontSize="12"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,4,0,12"
                                 ToolTip="e.g. notepad.exe, cmd.exe - TypeRight will not operate in these applications"/>

                        <!-- Start with Windows -->
                        <CheckBox x:Name="StartWithWindowsCheck" Content="Start TypeRight with Windows"
                                  FontSize="13" Foreground="#FF34495E" Margin="0,4,0,10"/>
                    </StackPanel>
                </Border>

                <!-- About Card -->
                <Border Background="White" CornerRadius="6" Padding="16" Margin="0,8,0,8"
                        BorderBrush="#FFE0E6ED" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Privacy &amp; Compatibility" Style="{StaticResource HeaderText}" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource BodyText}">
                            TypeRight processes text locally. No keystrokes are logged, no text is uploaded,
                            and personal learning is OFF by default. Windows 11 is the primary target;
                            Windows 10 support is best-effort.
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer buttons -->
        <Border Grid.Row="2" Background="#FFECF0F1" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ApplyButton" Content="Apply" Style="{StaticResource PrimaryButton}" Width="100" Click="ApplyButton_Click"/>
                <Button x:Name="SaveButton" Content="Save &amp; Close" Style="{StaticResource PrimaryButton}" Width="120" Click="SaveButton_Click"/>
                <Button x:Name="MinimizeButton" Content="Minimize to Tray" Style="{StaticResource PrimaryButton}" Width="130" Click="MinimizeButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>