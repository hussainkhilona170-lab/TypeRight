<Window x:Class="TypeRight.WPFOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TypeRight" Height="200" Width="400"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" Focusable="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Margin="10" FontSize="16" Foreground="#FF2C3E50" Text="TypeRight 2.0"/>
        <TextBlock Grid.Row="1" Margin="10" FontSize="14" Foreground="#666666" Text="Analyzing your input..." Name="StatusText"/>
        <StackPanel Grid.Row="2" Margin="10" Name="SuggestionsPanel"/>
    </Grid>
</Window>